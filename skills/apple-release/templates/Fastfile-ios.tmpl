# iOS release Fastfile.
# Substitutions:
#   APP_IDENTIFIER  — the bundle ID (e.g. com.example.MyApp)
#   SCHEME          — the Xcode scheme (typically the app name without spaces)
#   WORKSPACE       — typically <SCHEME>.xcworkspace (Tuist-generated)
#
# Invocation:
#   mise exec -- bundle exec fastlane beta_probe   # 10-sec ASC canary
#   mise exec -- bundle exec fastlane beta         # full build + upload
#
# Prerequisites (should already be true in any repo):
#   - Tuist-generated workspace
#   - fastlane/Matchfile pointing at the shared cert repo (see apple-release)
#   - MATCH_PASSWORD exported — the `ship` wrapper does this from pass
#   - ASC API key at ~/.appstoreconnect/private_keys/AuthKey_<ASC_KEY_ID>.p8

default_platform(:ios)

platform :ios do
  desc "Probe ASC via Spaceship to verify fastlane + API key are healthy"
  lane :beta_probe do
    api_key = app_store_connect_api_key(
      key_id: "<ASC_KEY_ID>",
      issuer_id: "<ASC_ISSUER_ID>",
      key_filepath: File.expand_path("~/.appstoreconnect/private_keys/AuthKey_<ASC_KEY_ID>.p8"),
      duration: 1200,
      in_house: false,
    )
    latest = latest_testflight_build_number(
      api_key: api_key,
      app_identifier: "APP_IDENTIFIER",
      initial_build_number: 0,
    )
    UI.success("ASC reachable — latest TestFlight build: #{latest}")
  end

  desc "Build the Release app and upload to TestFlight (internal only)"
  lane :beta do
    # Always rebuild the workspace from the Tuist manifest so the IPA
    # matches whatever's currently committed.
    sh("cd .. && tuist generate --no-open")

    # Signing is match, NOT automatic. Headless mosh/ssh shells have auid=-1
    # and the Security framework silently refuses to read keychain prefs
    # without a PAM audit session, so Xcode's automatic cert lookup fails
    # with no useful error. match imports the shared team cert on demand and
    # passes --keychain explicitly to codesign.
    ensure_asc_key_json          # Matchfile needs a key file path, not a Ruby object
    match(type: "appstore")

    build_app(
      workspace: "WORKSPACE",
      scheme: "SCHEME",
      configuration: "Release",
      export_method: "app-store",
      clean: true,
      output_directory: "build/fastlane",
      output_name: "SCHEME.ipa",
      include_bitcode: false,
      include_symbols: true,
      export_options: {
        signingStyle: "manual",
        provisioningProfiles: {
          "APP_IDENTIFIER" => "match AppStore APP_IDENTIFIER",
        },
      },
    )

    api_key = app_store_connect_api_key(
      key_id: "<ASC_KEY_ID>",
      issuer_id: "<ASC_ISSUER_ID>",
      key_filepath: File.expand_path("~/.appstoreconnect/private_keys/AuthKey_<ASC_KEY_ID>.p8"),
      duration: 1200,
      in_house: false,
    )

    # Upload and wait for processing so the script surfaces VALID state
    # (per these rules: never claim success until ASC says VALID).
    upload_to_testflight(
      api_key: api_key,
      ipa: "build/fastlane/SCHEME.ipa",
      skip_waiting_for_build_processing: false,
      skip_submission: true,
      distribute_external: false,
      notify_external_testers: false,
    )

    # Two post-upload follow-ups, both required:
    #   1. autoNotifyEnabled defaults to false on every new build →
    #      PATCH true so TestFlight pushes the notification.
    #   2. Testers in an internal group with hasAccessToAllBuilds=true
    #      stay in betaTester.state=null (no actual invite) until the
    #      tester is explicitly linked to the build via the
    #      individualTesters relationship → state flips to INVITED and
    #      TestFlight delivers the push.
    # Both bugs are documented in pink-lady-apple:testflight-ship.
    #
    # Point ASC_SCRIPT at the asc.py in your CHECKOUT of pink-lady-apple, not
    # at the plugin cache — cache paths are hash-pinned and break on every
    # plugin update. File.expand_path does not expand shell variables, so this
    # reads the env var explicitly and fails loudly if it is unset.
    asc_script = File.expand_path(
      ENV.fetch("ASC_SCRIPT") do
        UI.user_error!("ASC_SCRIPT is unset — point it at " \
                       "<checkout>/skills/testflight-ship/scripts/asc.py")
      end,
    )
    sh("uv tool run --from authlib --with httpx python3 #{asc_script} auto-notify --app-id APP_ID")
    # REQUIRED: link the build to the internal group (auto-resolved) and verify it
    # landed. Internal groups with hasAccessToAllBuilds=false do NOT get new builds
    # automatically — without this the build is VALID in ASC but never reaches any
    # tester's device. add-build-to-group retries and exits non-zero if the build
    # doesn't show up in the group, so a broken distribution FAILS the lane loudly
    # instead of silently leaving testers on an old build.
    sh("uv tool run --from authlib --with httpx python3 #{asc_script} add-build-to-group --app-id APP_ID")
    sh("uv tool run --from authlib --with httpx python3 #{asc_script} ensure-invited --app-id APP_ID")
  end
end
