# Settings for scripts/demo.sh. Copy to scripts/demo.env (gitignored) and
# change only what you need — every key below already has this default.
#
# The demo reads nothing else. It holds no credentials because no beat needs
# any: it deliberately does not run a TestFlight upload.

# Where beat 3 checks the skill's Ruby-floor claims. Point it at a mirror on a
# hostile venue network, or at a dead host to rehearse the degrade path:
#   RUBYGEMS_URL=http://127.0.0.1:1
RUBYGEMS_URL=https://rubygems.org/api/v1/versions/fastlane.json

# Seconds before beat 3 gives up and moves on.
RUBYGEMS_TIMEOUT=12

# Where the fetched response is kept so it can be inspected after the demo.
# `--cleanup` removes this directory, and only this directory.
# DEMO_CACHE=/tmp/pink-lady-apple-demo
